@inject IJSRuntime JS
@inject NavigationManager NavManager

<div class="submenu">
    <ul class="menu">
        <li class="@((currentSection == 1) ? "active" : "nonactive")" @onclick="() => ScrollToSection(1)">01</li>
        <li class="@((currentSection == 2) ? "active" : "nonactive")" @onclick="() => ScrollToSection(2)">02</li>
        <li class="@((currentSection == 3) ? "active" : "nonactive")" @onclick="() => ScrollToSection(3)">03</li>
        <li class="@((currentSection == 4) ? "active" : "nonactive")" @onclick="() => ScrollToSection(4)">04</li>
    </ul>
    <h5 class="submenuname">NAZWA SEKCJI</h5>
</div>

@* <li class="@((currentSection == "home") ? "active" : "")">Home</li>
<li class="@((currentSection == "about") ? "active" : "")">About</li> *@

<section id="section1" style="height:500px; border:1px solid #ccc;">
    Treść sekcji 1
</section>
<section id="section2" style="height:500px; border:1px solid #ccc;">Treść sekcji 2</section>
<section id="section3" style="height:500px; border:1px solid #ccc;">Treść sekcji 3</section>
<section id="section4" style="height:500px; border:1px solid #ccc;">Treść sekcji 4</section>


@code {
    public int currentSection { get; set; }
    private async Task ScrollToSection(int sectionId)
    {
        await JS.InvokeVoidAsync("scrollToElement", $"section{sectionId}");
    }

    private DotNetObjectReference<HomeOffer>? objRef;

    public DotNetObjectReference<HomeOffer> GetObjRef() => objRef!;
    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }
   

    [JSInvokable]
    public void UpdateCurrentSection(string sectionId)
    {
        char lastChar = sectionId[^1];
        currentSection = int.Parse(lastChar.ToString());
        StateHasChanged(); 
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("addScrollListener", GetObjRef());
        }
    }
}
