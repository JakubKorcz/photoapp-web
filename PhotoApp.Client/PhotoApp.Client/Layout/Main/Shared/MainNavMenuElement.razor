<div class="menu-element" @onclick="OnClick">
    <span class="material-symbols-outlined" id="icon" style="font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 40 ;">
        @ImageName
    </span>
    <p>@Description</p>
</div>

@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string ImageName { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;
}
