<nav class="main-nav-menu">
    <div class="elements up">
        <h2>LOGO</h2>
        <ul>
            @foreach (var mainItem in mainMenuItems)
            {
                <li @onclick="() => ToggleSubMenu(Enum.Parse<MenuOptions>(mainItem.Description))">
                    <MainNavMenuElement ImageName="@mainItem.IconName" Description="@mainItem.Description" />
                    @if (visibleSubMenu == Enum.Parse<MenuOptions>(mainItem.Description))
                    {
                        <ul class="submenu">
                            @foreach (var option in GetMenuSubOptions(Enum.Parse<MenuOptions>(mainItem.Description)))
                            {
                                <li>@option.Label</li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    </div>
    <div class="elements down">
        <ul>
            <li><MainNavMenuElement ImageName="help" Description="" /></li>
            <li><MainNavMenuElement ImageName="credit_card" Description="" /></li>
            <li><MainNavMenuElement ImageName="account_circle" Description="" /></li>
        </ul>
    </div>
</nav>
@if (visibleSubMenu == MenuOptions.Projekty )
{
    <MainNavSubMenuFolders/>
}

@code {
    enum MenuOptions
    {
        Projekty, Akcje, Opinie, Ustawienia, Więcej
    }

    private List<MenuItem> mainMenuItems = new()
    {
        new MenuItem { Description = MenuOptions.Projekty.ToString(), IconName="folder_open" },
        new MenuItem { Description = MenuOptions.Akcje.ToString(), IconName="notifications"},
        new MenuItem { Description = MenuOptions.Opinie.ToString(), IconName="feedback" },
        new MenuItem { Description = MenuOptions.Ustawienia.ToString(), IconName="settings" },
        new MenuItem { Description = MenuOptions.Więcej.ToString(), IconName="menu" }
    };

    private MenuOptions? visibleSubMenu = null;

    void ToggleSubMenu(MenuOptions description)
    {
        if (visibleSubMenu == description)
            visibleSubMenu = null;  
        else
            visibleSubMenu = description;
    }

    class MenuItem
    {
        public required string Description { get; set; }
        public required string IconName { get; set; }
    }

    private List<MenuOption> GetMenuSubOptions(MenuOptions selected) =>
    selected switch
    {
        MenuOptions.Więcej => new List<MenuOption>
        {
            new MenuOption { Label = "Opcja 1", Value = "option1" },
            new MenuOption { Label = "Opcja 2", Value = "option2" },
            new MenuOption { Label = "Opcja 3", Value = "option3" },
            new MenuOption { Label = "Opcja 4", Value = "option4" }
        },
        MenuOptions.Projekty => new List<MenuOption>(),
        MenuOptions.Ustawienia => new List<MenuOption>(),
        MenuOptions.Akcje => new List<MenuOption>(),
        _ => new List<MenuOption>(),
    };
}
