<div class="content"> 
    <UpperMenu></UpperMenu>
    <main class="main-content-body">
        @if (currentScreen == AppScreen.NewGallery)
        {
            <NewGalleryPage OnClick="ShowProjectDetailPage"/>            
        }

        @if (currentScreen == AppScreen.ProjectDetail)
        {
            <ProjectDetailPage/>    
        }
    </main>
</div>


@code {
    private enum AppScreen
    {
        NewGallery,
        ProjectDetail,
    }

    private AppScreen currentScreen;

    protected override void OnInitialized()
    {
        currentScreen = AppScreen.NewGallery;
    }   

    private void ShowProjectDetailPage()
    {
        currentScreen = AppScreen.ProjectDetail;
    }
}
