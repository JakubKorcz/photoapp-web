<div class="header">
        <span class="material-symbols-outlined link-btn" style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 40;" @onclick="CopyLink">
            link
        </span>
        <button class="share-btn">
            <span class="material-symbols-outlined share-icon" style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 40;" @onclick="Share">
                ios_share
            </span>
            Udostępnij projekt
        </button>
</div>

<div class="folder-structure">
    @if (Project != null)
    {
        @Project.ProjectName
        <span class="material-symbols-outlined edit-icon" style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 40;">
            edit
        </span>

        @if (Project.MainFolder.Folders != null && Project.MainFolder.Folders.Count > 0)
        {
            foreach (var folder in Project.MainFolder.Folders)
            {
                <div class="folder">
                    <span class="material-symbols-outlined folder-icon" style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 40;">
                        folder
                    </span>
                    <span class="folder-name">@folder.Name</span>
                </div>
            }
        }

        <div class="create-new-folder">
            <span class="material-symbols-outlined add-new-icon" style="font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 40;">
                create_new_folder
            </span>
            <span class="folder-name">Stwórz nowy folder</span>
        </div>
    }
</div>




@code {
    [Parameter]
    public ProjectDto Project{ get; set; }

    private async Task CopyLink()
    {
        var currentUrl = NavManager.Uri;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", currentUrl);
    }

    public void Share()
    {
        
    }
}
