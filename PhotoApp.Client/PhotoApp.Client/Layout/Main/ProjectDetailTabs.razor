<ul class="tabs">
    @foreach (var tab in Tabs)
    {
        <li class="@(SelectedTab == tab.Id ? "active" : "")" @onclick="() => SelectTab(tab.Id)">
            <span class="material-symbols-outlined" id="icon" style="font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 40 ;">
                @tab.IconName
            </span>
            @tab.Description
        </li>
    }
    <li class="@(SelectedTab == ImportTab.Id ? "active" : "")" @onclick="() => SelectTab(ImportTab.Id)">
        <button class="import-btn">
            <span class="material-symbols-outlined" id="icon" style="font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 40 ;">
                @ImportTab.IconName
            </span>
            @ImportTab.Description
        </button>
    </li>
</ul>


@code {
    [Parameter] public int? SelectedTab { get; set; } = null;
    [Parameter] public EventCallback<int> SelectTab { get; set; }
    [Parameter] public List<MenuItem> Tabs { get; set; }
    [Parameter] public MenuItem ImportTab { get; set; }
}
