@using PhotoApp.Client.Connection
@using PhotoApp.Client.Models
@using PhotoApp.Common.Models

@inject NavigationManager NavigationManager

<EditForm Model="@validationCode" OnValidSubmit="HandleCodeWrite">
    <div class="six-boxes mov_text">
        @for (int i = 0; i < 6; i++)
        {
            var index = i;
            <input type="text" maxlength="1" class="code-box" value="@codeDigits[index]" inputmode="numeric"
                   @oninput="@(e => OnDigitInput(index, e))"
                   @onkeydown="@(e => OnKeyDown(index, e))"
                   @ref="@inputRefs[index]"/>
        }
    </div>
    <button class="girisbtn auth_btn mov_text" tabindex="101">Submit Code</button>
</EditForm>

@code {
    [Parameter] public bool IsLogin { get; set; }
    [Parameter] public UserModel User { get; set; }

    private ValidationCode validationCode = new();
    private string[] codeDigits = new string[6] { "", "", "", "", "", "" };
    private ElementReference[] inputRefs = new ElementReference[6];
    private string? lastKey;


    private async void HandleCodeWrite()
    {
        var code = string.Join("", codeDigits);
        using (var conn = new ApiConnection())
        {
            ServerAuthResponse res;
            if (IsLogin)
            {
                res = await conn.LoginVerify(User.Email, code);
            }
            else
            {
                res = await conn.RegisterVerify(User.Email, code);
            }

            Console.WriteLine(res.Message.ToString());
            if (res.Success)
            {
                //Zapisz kod do cookies ???
                NavigationManager.NavigateTo("/main");
            }
            else
            {
                //rzuc bledem i zreloaduj strone
            }
        }
    }

    private async void OnDigitInput(int index, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrEmpty(value))
        {
            Console.WriteLine($"Jestem {index}");
            // Weź tylko pierwszy znak nowej wartości
            var input = value.Substring(0, 1);

            input = new string(input.Where(char.IsDigit).ToArray());

            // Nadpisz poprzednią wartość (czyli usuwamy starą i zapisujemy tylko nową)
            codeDigits[index] = input;

            // Przenieś focus na następne pole
            if (index < inputRefs.Length - 1)
            {
                await inputRefs[index + 1].FocusAsync();
            }

            // Wymuś renderowanie (czasem potrzebne, żeby UI odświeżył wartość)
            StateHasChanged();
        }

        if (lastKey == "Backspace" && index > 0)
        {
            await inputRefs[index - 1].FocusAsync();
        }

        // if (lastKey == "ArrowLeft" && index > 0)
        // {
        //     await inputRefs[index - 1].FocusAsync();
        // }

        // if (lastKey == "ArrowRight" && index < 5)
        // {
        //     await inputRefs[index + 1].FocusAsync();
        // }
    }

    private void OnKeyDown(int index, KeyboardEventArgs e)
    {
        lastKey = e.Key;   
        if (!string.IsNullOrEmpty(codeDigits[index])
            && e.Key.Length == 1 
            && !e.CtrlKey && !e.AltKey && !e.MetaKey)
        {
            codeDigits[index] = "";
        }
    }
}
