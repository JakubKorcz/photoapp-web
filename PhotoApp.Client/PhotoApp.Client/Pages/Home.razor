@page "/"

@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

<div style="position: relative; width: 100vw; height: 90vh; margin: 0;">
    <div class="video-overlay-top"></div>
    <video autoplay muted loop
           style="padding: 0; width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 1;">
        <source src="video/movie-home.mp4" type="video/mp4">
        Twoja przeglądarka nie obsługuje wideo.
    </video>


    <div class="nav-div">
        <NavMenu />
    </div>

    <div class="container custom-home d-flex justify-content-start align-items-center">
        <div class="custom-text-section">
            <h1 class="custom-title">
                UdostepniajAA swoje zdjęcia z chmury
            </h1>
            <p class="custom-desc">
                Dłuższy tekst opisujący naszą konkretną ofertę można tu różne pierdoły opisać, ale generalnie jest do wymyślenia później jak będzie się już tą stronę kończyć pisać
            </p>
            <button class="btn btn-light arsenal custom-btn">
                Dowiedz się więcej
            </button>
        </div>
        <div class="custom-empty"></div>
    </div>
</div>

@* <div style="position: relative; width: 100vw; height: 90vh; margin: 0;">
   
</div> *@

<ul style="list-style:none; padding:0; width:200px; background:#eee;">
    <li style="padding:10px; cursor:pointer;" @onclick="() => ScrollToSection(1)">Sekcja 1</li>
    <li style="padding:10px; cursor:pointer;" @onclick="() => ScrollToSection(2)">Sekcja 2</li>
    <li style="padding:10px; cursor:pointer;" @onclick="() => ScrollToSection(3)">Sekcja 3</li>
</ul>
<div id="section1" style="height:500px; border:1px solid #ccc;">Treść sekcji 1</div>
<div id="section2" style="height:500px; border:1px solid #ccc;">Treść sekcji 2</div>
<div id="section3" style="height:500px; border:1px solid #ccc;">Treść sekcji 3</div>

@code {
    private async Task ScrollToSection(int sectionId)
    {
        await JS.InvokeVoidAsync("scrollToElement", $"section{sectionId}");
    }
}