<div class="menu-element" @onclick="OnClick">
    <span class="material-symbols-outlined" id="icon" style="font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 40 ;">
        @MenuItem.IconName
    </span>
    <p>@MenuItem.Description</p>
    @if (!string.IsNullOrEmpty(MenuItem.OnHoverText))
    {
        <ul class="hint">          
            <li>@MenuItem.OnHoverText</li>
        </ul>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public MenuItem MenuItem { get; set; } = new MenuItem
    {
        Description = "",
        IconName = ""
    };
}
