<div class="boxes both-padding">
    @for (int i = 0; i < boxCount; i++)
    {
        var index = i;
        <div class="section-box">
            <img class="plus-icon @(isRotated[index] ? "rotate-45" : "")" src="jpg/plus.png" @onclick="() => ToggleRotate(index)" />
            <div class="text">
                <h3>@GetHeader(index)</h3>
                <p>@GetParagraph(index)</p>
            </div>
        </div>
    }
</div>

@code {
    private const int boxCount = 3;
    private bool[] isRotated = new bool[boxCount];

    protected override void OnInitialized()
    {
        for (int i = 0; i < boxCount; i++)
            isRotated[i] = false;
        InitTexts();
    }

    private void ToggleRotate(int index)
    {
        isRotated[index] = !isRotated[index];
    }

    private string GetHeader(int i)
    {
        return "Dupa";
    }

    private string GetParagraph(int i)
    {
        if (isRotated[i])
            return "";
        else
            return "";
    }

    private List<BoxText> texts = [];

    private void InitTexts()
    {
        texts.Append(new BoxText() { });
    }

    internal class BoxText
    {
        public string Header { get; set; }
        public string ShortParagraph { get; set; }
        public string LongParagraph { get; set; }
    } 
}
