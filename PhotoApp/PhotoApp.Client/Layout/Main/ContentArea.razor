<div class="content"> 
    <UpperMenu></UpperMenu>
    <main class="main-content-body">
        @if (currentScreen == AppScreen.NewGallery)
        {
            <NewGalleryPage OnClick="ShowNewGalleryBaseInformationPopup" />
            if (showNewGalleryBaseInformationPopup)
            {
                <NewGalleryBaseInformationPopup OnOkClicked="@ShowProjectDetailPage" OnCancelClicked="@HideNewGalleryBaseInformationPopup">

                </NewGalleryBaseInformationPopup>
            }
        }

        @if (currentScreen == AppScreen.ProjectDetail)
        {
            <ProjectDetailPage/>    
        }
    </main>
</div>


@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    private bool showNewGalleryBaseInformationPopup = false;
    private enum AppScreen
    {
        NewGallery,
        ProjectDetail,
    }

    private AppScreen currentScreen;

    protected override void OnInitialized()
    {
        if (ProjectId == null) 
        {
            currentScreen = AppScreen.NewGallery;
        }
        else
        {
            currentScreen = AppScreen.ProjectDetail;
        }

    }   

    private void ShowProjectDetailPage()
    {
        currentScreen = AppScreen.ProjectDetail;
    }

    private void ShowNewGalleryBaseInformationPopup()
    {
        showNewGalleryBaseInformationPopup = true;
    }

    private void HideNewGalleryBaseInformationPopup()
    {
        showNewGalleryBaseInformationPopup = false;
    }
}
